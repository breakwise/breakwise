{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bumpfix/bumpfix/main/schema/notice-0.1.schema.json",
  "title": "bumpfix notice",
  "description": "One breaking change in one package. Format version 0.1. See docs/notice-format.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "status",
    "published",
    "package",
    "type",
    "breaks_in",
    "summary",
    "example",
    "references"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^BFX-[0-9]{4}-[0-9]{4,}$"
    },
    "status": {
      "enum": ["draft", "verified"]
    },
    "published": {
      "$ref": "#/$defs/date"
    },
    "modified": {
      "$ref": "#/$defs/date"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ecosystem", "name"],
      "properties": {
        "ecosystem": {
          "enum": ["PyPI"]
        },
        "name": {
          "$ref": "#/$defs/package_name"
        },
        "aliases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/package_name"
          }
        }
      }
    },
    "type": {
      "enum": ["rename", "removal", "signature", "behavior"]
    },
    "breaks_in": {
      "$ref": "#/$defs/version"
    },
    "works_since": {
      "$ref": "#/$defs/version"
    },
    "summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 200
    },
    "rename": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {
          "$ref": "#/$defs/dotted_name"
        },
        "to": {
          "$ref": "#/$defs/dotted_name"
        }
      }
    },
    "instructions": {
      "type": "string",
      "minLength": 10
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": {
          "type": "string",
          "minLength": 1
        },
        "after": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^https://[^\\s]+$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"type": {"const": "rename"}},
        "required": ["type"]
      },
      "then": {
        "required": ["rename"]
      },
      "else": {
        "required": ["instructions"],
        "not": {"required": ["rename"]}
      }
    }
  ],
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "package_name": {
      "description": "Normalized PyPI name: lowercase letters and digits, words joined by single hyphens.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "version": {
      "description": "A PEP 440 public version, e.g. 2.0.0, 1.0.0rc1, 2.1.0.post1.",
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)*((a|b|rc)[0-9]+)?(\\.post[0-9]+)?(\\.dev[0-9]+)?$"
    },
    "dotted_name": {
      "description": "A Python import path, e.g. pydantic_ai.models.openai.OpenAIModel.",
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)+$"
    }
  }
}
